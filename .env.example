# Environment variables template for llm_serving
# Copy this file to .env and fill in your values. Never commit actual secret tokens.

# Hugging Face Access Token (required to download Meta-Llama-3-8B-Instruct)
HF_TOKEN=your_huggingface_token_here

# Required by lm-evaluation-harness to execute Python code for HumanEval
HF_ALLOW_CODE_EVAL=1

# Python path configuration for local development
PYTHONPATH=src

# Optional vLLM server settings
# VLLM_API_KEY=your_optional_api_key
